{
  "name": "sotizence-play-books-browser",
  "productName": "Sotizence Play Books Browser",
  "version": "1.0.0",
  "description": "Desktop browser for Google Play Books with Proton VPN WireGuard tunnel",
  "main": "src/main/main.js",
  "author": "Sotizence",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sotizence.playbooks.browser",
    "productName": "Sotizence Play Books Browser",
    "artifactName": "SotizencePlayBooksBrowser-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "bin/**/*", "extensions/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["bin/**/*", "extensions/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sotizence Play Books Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
