{
  "author": "Monjurul Islam (Moxixo)",
  "build": {
    "appId": "com.moxixo.antidetect",
    "copyright": "Copyright © 2026 Moxixo — Monjurul Islam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Network",
      "icon": "assets/icon.png",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "AppImage"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "deb"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "arch": [
            "x64",
            "arm64"
          ],
          "target": "dmg"
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "Moxixo Antidetect Browser"
    },
    "productName": "Moxixo Antidetect Browser",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "portable"
        }
      ]
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {},
  "description": "Moxixo Antidetect Browser — multi-profile browser manager with isolated fingerprints, per-profile proxy and persistent sessions. Built with Electron + Node.js.",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "moxixo-antidetect-browser",
  "scripts": {
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "start": "electron ."
  },
  "version": "1.2.1"
}