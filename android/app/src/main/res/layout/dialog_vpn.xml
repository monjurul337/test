<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_bar"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#33FFFFFF" />

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/primary_accent"
            android:contentDescription="Shield" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proton VPN &amp; Proxy"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/tvVpnStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Route Android WebView traffic through Proton VPN WireGuard tunnel or SOCKS5 / HTTP proxy."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Connect VPN"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_accent"
            android:layout_marginEnd="8dp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestIp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Check IP"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_card"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Scrollable container for settings -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. VPN Config File Import Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Proton / WireGuard Config"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnProtonDownloadLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="account.protonvpn.com ↗"
                        android:textColor="@color/primary_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload a WireGuard (.conf) or OpenVPN (.ovpn) file, or paste text below."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

                <!-- Upload Button & File Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportVpnFile"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="📁 Upload Config"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/surface_card"
                        app:strokeColor="@color/primary_accent"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tvVpnFileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No file uploaded yet"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <ImageView
                        android:id="@+id/btnClearVpnConfig"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_close"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear config"
                        android:visibility="gone"
                        app:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Config Text Area -->
                <EditText
                    android:id="@+id/etVpnConfigText"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_search_pill"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:padding="8dp"
                    android:hint="[Interface]&#10;PrivateKey = ...&#10;Address = 10.2.0.2/32&#10;[Peer]&#10;Endpoint = host:port"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!-- 2. Proxy Configuration Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxy Endpoint"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Host and Port -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Host IP"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etProxyHost"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_search_pill"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:text="127.0.0.1"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Port"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etProxyPort"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_search_pill"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:text="10808"
                            android:inputType="number"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Auto-connect toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-connect on startup"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAutoConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProxy"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Save &amp; Apply VPN / Proxy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_accent"
                app:cornerRadius="12dp"
                android:layout_marginBottom="6dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
