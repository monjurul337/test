<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_bar"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#33FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- 1. Proton VPN & Proxy Tile -->
    <LinearLayout
        android:id="@+id/btnSettingVpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/primary_accent"
            android:contentDescription="VPN" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proton VPN &amp; Proxy (WireGuard)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsVpnSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOCKS5 127.0.0.1:10808 · Disconnected"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettingsVpnBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- 2. Play Books Auto Uploader v9.26 (Chrome Extension) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_puzzle"
                app:tint="@color/accent_teal"
                android:contentDescription="Extension" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Books Auto Uploader"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExtensionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v9.26 Active on Partner Center"
                    android:textColor="@color/active_green"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swExtension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnToggleExtensionPanel"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="📚 Open / Toggle Uploader Panel"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 3. Profiles & Sessions -->
    <LinearLayout
        android:id="@+id/btnSettingProfiles"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_user"
            app:tint="@color/primary_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Browser Profile"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />

        <TextView
            android:id="@+id/tvCurrentProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4. Bookmarks -->
    <LinearLayout
        android:id="@+id/btnSettingBookmarks"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bookmarks"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />
    </LinearLayout>

    <!-- 5. History -->
    <LinearLayout
        android:id="@+id/btnSettingHistory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browsing History"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />
    </LinearLayout>

    <!-- 6. Search Engine Selector -->
    <LinearLayout
        android:id="@+id/btnSettingSearchEngine"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search Engine"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />

        <TextView
            android:id="@+id/tvSearchEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 7. Quick Partner Center -->
    <LinearLayout
        android:id="@+id/btnQuickPartnerCenter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Play Books Partner Center"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />
    </LinearLayout>

    <!-- 8. Clear Data Option -->
    <LinearLayout
        android:id="@+id/btnClearData"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            app:tint="#EF4444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_data"
            android:textColor="#EF4444"
            android:textSize="13.5sp"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp" />
    </LinearLayout>

    <!-- App version footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Sotizence Play Books Browser v1.0.0 (Kotlin Dual Engine)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="14dp" />

</LinearLayout>
