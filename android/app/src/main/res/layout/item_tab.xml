<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="10dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivTabFavicon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_accent"
            android:contentDescription="Favicon" />

        <TextView
            android:id="@+id/tvTabTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:text="Tab Title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE"
            android:textColor="@color/active_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnCloseTab"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close tab"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTabUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="https://..."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:singleLine="true"
        android:layout_marginTop="4dp" />

</LinearLayout>
