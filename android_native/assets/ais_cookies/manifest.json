{
  "manifest_version": 2,
  "name": "MJ STUDIO bridge",
  "version": "1.1",
  "description": "Image to Prompt overlay for the built-in browser, and the Gemini session cookies for MJ STUDIO (stays on this device).",
  "browser_specific_settings": {
    "gecko": {
      "id": "ais-cookies@mjstudio"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "cookies",
    "nativeMessaging",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini_bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.stableaudio.com/*",
        "https://*.authkit.app/*"
      ],
      "js": [
        "stable_audio_hook.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}