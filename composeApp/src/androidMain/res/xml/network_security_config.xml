<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext anywhere: everything the browser fetches must be TLS,
         and the tunnel itself is UDP/WireGuard (not HTTP). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
